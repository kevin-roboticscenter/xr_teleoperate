+class CameraMosaic(BaseCamera):
+    """Compose the two wrist streams for the existing XR head-image transport."""
+    def __init__(self, topic, shape, fps, cameras, sources, port):
+        super().__init__(topic, shape, fps, enable_zmq=True, zmq_port=port)
+        self.cameras, self.sources = cameras, sources
+
+    def _update_frame(self):
+        height, width = self._img_shape
+        image = np.full((height, width, 3), 22, dtype=np.uint8)
+        cv2.putText(image, 'Hand cameras | head camera not connected', (16, 28),
+                    cv2.FONT_HERSHEY_SIMPLEX, .65, (230, 230, 230), 1)
+        tile_width = width // len(self.sources)
+        for index, source in enumerate(self.sources):
+            x = index * tile_width
+            cv2.putText(image, source['label'], (x + 16, 58),
+                        cv2.FONT_HERSHEY_SIMPLEX, .6, (230, 230, 230), 1)
+            camera = self.cameras.get(source['topic'])
+            frame = camera.latest_bgr if camera and time.monotonic() - camera.last_frame_time < 2 else None
+            if frame is None:
+                cv2.putText(image, 'Waiting for frames', (x + 16, 100),
+                            cv2.FONT_HERSHEY_SIMPLEX, .6, (70, 170, 240), 1)
+                continue
+            scale = min((tile_width - 24) / frame.shape[1], (height - 82) / frame.shape[0])
+            resized = cv2.resize(frame, (round(frame.shape[1] * scale), round(frame.shape[0] * scale)))
+            ox, oy = x + (tile_width - resized.shape[1]) // 2, 72 + (height - 82 - resized.shape[0]) // 2
+            image[oy:oy + resized.shape[0], ox:ox + resized.shape[1]] = resized
+        self.latest_bgr, self.last_frame_time = image, time.monotonic()
+        ok, encoded = cv2.imencode('.jpg', image, [cv2.IMWRITE_JPEG_QUALITY, 85])
+        if ok:
+            self._zmq_buffer.write(encoded.tobytes())
+            self._ready.set()
+
+    def release(self):
+        pass
+
