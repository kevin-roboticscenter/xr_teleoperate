@@ -0,0 +1,95 @@
+"""Persist launch-time Dex5 stiffness settings without contacting a robot."""
+from dataclasses import dataclass
+import json
+import math
+import os
+from pathlib import Path
+import tempfile
+
+
+MIN_MULTIPLIER = 0.5
+MAX_MULTIPLIER = 2.5
+
+
+@dataclass(frozen=True)
+class GainProfile:
+    finger_multiplier: float = 1.2
+    thumb_multiplier: float = 1.2
+
+    def __post_init__(self):
+        for name in ('finger_multiplier', 'thumb_multiplier'):
+            value = getattr(self, name)
+            if (isinstance(value, bool) or not isinstance(value, (int, float))
+                    or not math.isfinite(value)
+                    or not MIN_MULTIPLIER <= value <= MAX_MULTIPLIER):
+                raise ValueError(f'{name} must be a number from {MIN_MULTIPLIER} to {MAX_MULTIPLIER}')
+
+    @classmethod
+    def from_dict(cls, values):
+        if not isinstance(values, dict) or set(values) != {'finger_multiplier', 'thumb_multiplier'}:
+            raise ValueError('Provide finger_multiplier and thumb_multiplier')
+        return cls(**values)
+
+    @classmethod
+    def from_environment(cls, env=None):
+        env = os.environ if env is None else env
+        return cls(float(env.get('DEX5_FINGER_MULTIPLIER', '1.2')),
+                   float(env.get('DEX5_THUMB_MULTIPLIER', '1.2')))
+
+    @property
+    def finger_kp(self):
+        return 0.10 * self.finger_multiplier
+
+    @property
+    def finger_kd(self):
+        return 0.001 * (1.0 + 0.5 * (self.finger_multiplier - 1.0))
+
+    @property
+    def thumb_kp(self):
+        return 1.0 * self.thumb_multiplier
+
+    @property
+    def thumb_kd(self):
+        return 0.02 * (1.0 + 0.5 * (self.thumb_multiplier - 1.0))
+
+    def settings(self):
+        return {'finger_multiplier': self.finger_multiplier, 'thumb_multiplier': self.thumb_multiplier}
+
+    def describe(self):
+        return dict(self.settings(), finger_kp=self.finger_kp, finger_kd=self.finger_kd,
+                    thumb_kp=self.thumb_kp, thumb_kd=self.thumb_kd)
+
+    def environment(self):
+        return {'DEX5_FINGER_MULTIPLIER': str(self.finger_multiplier),
+                'DEX5_THUMB_MULTIPLIER': str(self.thumb_multiplier)}
+
+
+class GainStore:
+    def __init__(self, path):
+        self.path = Path(path)
+
+    def load(self):
+        try:
+            values = json.loads(self.path.read_text())
+        except FileNotFoundError:
+            return GainProfile()
+        except json.JSONDecodeError as exc:
+            raise ValueError(f'Invalid hand stiffness settings: {exc}') from exc
+        return GainProfile.from_dict(values)
+
+    def save(self, profile):
+        if not isinstance(profile, GainProfile):
+            raise TypeError('Expected a GainProfile')
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        temporary = None
+        try:
+            with tempfile.NamedTemporaryFile('w', dir=self.path.parent, delete=False) as target:
+                temporary = target.name
+                json.dump(profile.settings(), target, indent=2)
+                target.write('\n')
+                target.flush()
+                os.fsync(target.fileno())
+            os.replace(temporary, self.path)
+        finally:
+            if temporary and os.path.exists(temporary):
+                os.unlink(temporary)
